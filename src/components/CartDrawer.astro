---

---

<div
	id="cart-drawer-root"
	class="pointer-events-none fixed inset-0 z-[95]"
	aria-hidden="true"
>
	<div
		id="cart-drawer-backdrop"
		class="fixed inset-0 z-[96] bg-ink/50 opacity-0 transition-opacity duration-300 ease-out pointer-events-none"
		aria-hidden="true"
	></div>

	<aside
		id="cart-drawer-panel"
		class="fixed right-0 top-0 z-[97] flex h-full w-full max-w-md flex-col bg-cream shadow-2xl ring-1 ring-ink/10 translate-x-full transition-transform duration-300 ease-out"
		role="dialog"
		aria-modal="true"
		aria-labelledby="cart-drawer-title"
		tabindex="-1"
	>
		<div class="flex shrink-0 items-center justify-between border-b border-ink/10 bg-white px-5 py-4">
			<h2 id="cart-drawer-title" class="font-display text-xl font-semibold text-violet-deep">
				Carrinho
			</h2>
			<button
				type="button"
				id="cart-drawer-close"
				class="rounded-sm border border-ink/15 p-2 text-ink-muted transition hover:border-gold hover:text-violet-deep"
				aria-label="Fechar carrinho"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					aria-hidden="true"
				>
					<path d="M18 6 6 18"></path>
					<path d="m6 6 12 12"></path>
				</svg>
			</button>
		</div>

		<div
			id="cart-drawer-empty"
			class="flex flex-1 flex-col items-center justify-center gap-4 px-6 py-10 text-center"
		>
			<p class="text-ink-muted">Seu carrinho está vazio.</p>
			<a href="/catalogo" class="btn-primary text-sm"> Ver catálogo </a>
		</div>

		<div id="cart-drawer-content" class="hidden min-h-0 flex-1 flex flex-col">
			<ul
				id="cart-drawer-lines"
				class="min-h-0 flex-1 divide-y divide-ink/10 overflow-y-auto overscroll-contain"
			>
			</ul>
			<div
				class="shrink-0 border-t border-ink/10 bg-white p-5 shadow-[0_-4px_20px_rgba(0,0,0,.06)]"
			>
				<p class="font-display text-lg font-semibold text-violet-deep">
					Total: <span id="cart-drawer-total"></span>
				</p>
				<div class="mt-4 flex flex-wrap gap-2">
					<button type="button" id="cart-drawer-clear" class="btn-ghost flex-1 text-sm min-w-[8rem]">
						Limpar
					</button>
					<button type="button" id="cart-drawer-wa" class="btn-primary flex-1 text-sm min-w-[8rem]">
						Comprar
					</button>
				</div>
				<p
					id="cart-drawer-wa-hint"
					class="mt-3 hidden text-center text-xs text-ink-muted"
				>
					Configure <code class="rounded bg-cream-dark/80 px-1 py-0.5">PUBLIC_WHATSAPP_NUMBER</code> no
					ambiente.
				</p>
			</div>
		</div>
	</aside>
</div>
